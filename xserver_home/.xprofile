# Dual monitor displays
"$HOME/.scripts/dual-monitor-setup.sh"

# Export session type
export XDG_SESSION_TYPE=x11
export GDK_BACKEND=x11

# Start network applet in the background
nm-applet &

# Restore wallpaper
sh ~/.fehbg &

# Start brave browser
(sleep 10 && brave) &

# Thunderbird
# (sleep 30 && thunderbird) &

# Xsettingsd
xsettingsd &

# Set the default cursor to 'left_ptr'
xsetroot -cursor_name left_ptr

# Load Xresources
xrdb -merge ~/.Xresources

# Launch BSPWM
exec bspwm
